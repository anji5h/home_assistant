# PostgreSQL + TimescaleDB Configuration
# Copy this file to .env and update with your actual values

# Database Connection Settings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=home_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Workload Profile: LOW, MEDIUM, or HIGH
# LOW: 25 inserts/sec, 1 writer, 10K sensors (20-40% CPU)
# MEDIUM: 100 inserts/sec, 2 writers, 25K sensors (50-70% CPU)
# HIGH: 750 inserts/sec, 5 writers, 50K sensors (90-100% CPU)
WORKLOAD=LOW

# Write/Read Intervals (seconds)
# Write interval: How often to write batches (1 = every second)
# Read interval: How often to run dashboard queries (20 = every 20 seconds)
WRITE_INTERVAL=1
READ_INTERVAL=20

# TimescaleDB Data Retention and Compression Settings
# Retention period (hours): How long to keep raw data before dropping
# Compression period (hours): How long before data is compressed
TIMESCALE_RETENTION_HOURS=72
TIMESCALE_COMPRESSION_HOURS=6