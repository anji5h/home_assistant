# PostgreSQL + TimescaleDB Configuration
# Copy this file to .env and update with your actual values
# For detailed information, see README.md

# Database Connection Settings
# Host: PostgreSQL service hostname (use 'postgres' in Docker Compose)
# Port: PostgreSQL port (default 5432)
# Database: Database name for Home Assistant sensor data
# User: PostgreSQL user with appropriate permissions
# Password: PostgreSQL user password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=home_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Workload Profile: LOW, MEDIUM, or HIGH
# Determines the data ingestion rate and concurrency level
# LOW: 25 inserts/sec, 1 writer, 10,000 sensors (20-40% CPU)
#      - Use case: Background/idle ingestion, baseline testing
# MEDIUM: 100 inserts/sec, 2 writers, 25,000 sensors (50-70% CPU)
#         - Use case: Sustained real-world load testing
# HIGH: 750 inserts/sec, 5 writers, 50,000 sensors (90-100% CPU)
#       - Use case: Stress/endurance testing
WORKLOAD=LOW

# Write/Read Intervals (seconds)
# Write interval: How often to write sensor data batches (1 = every second)
# Read interval: How often to run dashboard/statistics queries (20 = every 20 seconds)
# Adjust these values to control load and query frequency
WRITE_INTERVAL=1
READ_INTERVAL=20

# TimescaleDB Data Retention and Compression Settings
# Retention period (hours): How long to keep raw data before automatic deletion
# - Default: 72 hours (3 days)
# - Recommended: 72-2160 hours (3-90 days depending on disk space)
# Compression period (hours): How long before data is automatically compressed
# - Default: 6 hours
# - Compressed data uses ~90% less disk space (5 bytes vs 50 bytes per row)
TIMESCALE_RETENTION_HOURS=72
TIMESCALE_COMPRESSION_HOURS=6

# Application Settings (optional, computed from WORKLOAD if not set)
# Number of concurrent database writers
# Number of simulated sensors to generate
# These are automatically calculated based on WORKLOAD profile
# Uncomment and set manually only if you need custom values
# NUM_WRITERS=1
# NUM_SENSORS=10000